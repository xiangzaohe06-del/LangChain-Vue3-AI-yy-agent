# Copy to .env and fill in locally. Never commit real credentials.
# Chat: choose a model enabled in your own Bailian region/account.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=

# Tavily official remote MCP. Legacy TVILY_API_KEY is also supported.
TAVILY_API_KEY=
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/
TAVILY_MCP_TIMEOUT=30

# Start your own local MongoDB first. Browser IDs are not account authentication.
MONGODB_URI=mongodb://localhost:27017
USER_MEMORY_DATABASE=dietitian

# Minimal local RAG setup. No cloud publishing until explicitly configured.
RAG_STORAGE=local
RAG_VECTOR_BACKEND=usearch
RAG_EMBEDDING_MODEL=text-embedding-v4
# Optional embedding credentials; default to the chat endpoint/key above.
# RAG_EMBEDDING_BASE_URL=
# RAG_EMBEDDING_API_KEY=
RAG_QUERY_REWRITE=true
RAG_RERANK=true
RAG_MAX_QUERIES=3
RAG_FETCH_K=20
RAG_RERANK_TOP_K=8
RAG_NEIGHBOR_RADIUS=1
RAG_CONTEXT_CHARS=6000
RAG_AUTO_UPDATE=false
RAG_WATCH_DIRECTORY=knowledge/documents
RAG_WATCH_SOURCES=knowledge/sources.json
RAG_WATCH_INTERVAL=5
RAG_AUTO_UPDATE_RETRY_SECONDS=30

# Optional COS uploads / knowledge snapshots. Use your own account and bucket.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_APP_ID=
COS_BUCKET=
COS_REGION=ap-beijing
# RAG_COS_BUCKET=
RAG_COS_PREFIX=knowledge/nutrition

# Optional Milvus: start docker-compose.milvus.yml, then change backend to milvus.
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_DB_NAME=default
MILVUS_COLLECTION_PREFIX=nutrition_hnsw
MILVUS_TIMEOUT=120
MILVUS_INSERT_BATCH=100
RAG_HNSW_M=16
RAG_HNSW_EF_CONSTRUCTION=200
RAG_HNSW_EF_SEARCH=256

# Conversation request budget (approximate tokens).
CHAT_CONTEXT_TOKENS=32000
CHAT_OUTPUT_TOKENS=4096
CHAT_SUMMARY_TRIGGER_TOKENS=6000
CHAT_SUMMARY_TRIGGER_MESSAGES=24
CHAT_KEEP_RECENT_TURNS=4
