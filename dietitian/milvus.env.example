# Copy these settings into dietitian/.env after starting Milvus and importing data.
# RAG_STORAGE chooses the snapshot source; it is independent of the search backend.
RAG_VECTOR_BACKEND=milvus
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_DB_NAME=default
MILVUS_COLLECTION_PREFIX=nutrition_hnsw
MILVUS_TIMEOUT=120
MILVUS_INSERT_BATCH=100
RAG_HNSW_M=16
RAG_HNSW_EF_CONSTRUCTION=200
RAG_HNSW_EF_SEARCH=256
